# Produktions-Konfiguration (hinter Cloudflare / HTTPS)
# Kopiere diese Datei nach `.env` und passe sie an. `.env` wird NICHT eingecheckt
# und nicht mit deployt (siehe .gitignore / GitHub-Actions rsync-Excludes).
# docker compose liest `.env` automatisch für die ${VAR}-Platzhalter.

# Session-Cookies nur über HTTPS ausliefern.
# Standard in Produktion ist bereits AN (NODE_ENV=production im Image).
# Nur auf "false" setzen, wenn du die Prod-Images lokal über http://localhost testest.
COOKIE_SECURE=true

# Gültigkeit einer Session in Tagen (Sliding-Renewal verlängert bei Nutzung).
SESSION_TTL_DAYS=30

# Selbst-Registrierung erlauben ("true") oder komplett sperren ("false").
ALLOW_REGISTRATION=true

# Optional: erlaubte Cross-Origin(s) mit Credentials, kommagetrennt.
# Leer lassen, wenn Frontend und API über dieselbe Domain laufen (Standard).
# CORS_ORIGIN=https://labviz.example.com

# ── Instanz-Limits ────────────────────────────────────────────────────────────
# Lab Visualizer ist vollständig kostenlos — diese Werte sind KEINE Bezahlschranke,
# sondern Missbrauchsschutz für Instanzen, die für Fremde offen stehen.
#
# Standard: leer = unbegrenzt. Beim Self-Hosting im eigenen Netz einfach so lassen.
# Betreibst du eine öffentliche Instanz, setze Obergrenzen, damit ein einzelnes
# Konto nicht dein Volume füllt. Überschreitungen liefern HTTP 403 + code
# "limit_reached"; die UI zeigt dann einen Hinweis mit Verweis aufs Self-Hosting.
#
# Achtung: Jedes neue Konto bekommt ein Beispielprojekt (1 Projekt, 3 Ebenen,
# 18 Nodes). Kleinere Werte lehnt das Backend beim Start ab, weil sonst niemand
# mehr registrieren könnte.
# MAX_PROJECTS_PER_USER=5
# MAX_VIEWS_PER_PROJECT=20
# MAX_NODES_PER_PROJECT=500
# MAX_ASSETS_PER_USER=100

# Groesste erlaubte Bilddatei (eigene Node-Icons, Bilder in Notizen) in Bytes.
# Anders als die Limits darueber ist das KEINE Plan-Grenze, sondern ein
# technischer Riegel: der Upload liegt beim Verarbeiten komplett im Speicher,
# und MAX_BODY muss den base64-Aufschlag von einem Drittel noch tragen.
# Standard: 1048576 (1 MB).
# MAX_ASSET_BYTES=1048576

# Schreib-Requests pro Minute und IP (GET/HEAD bleiben ungedrosselt).
# Standard 600 — hoch genug für API-Scripting, bremst aber Endlosschleifen und
# Massen-Inserts. 0 schaltet die Drosselung ganz ab.
# RATE_LIMIT_WRITES_PER_MIN=600

# Größe eines Request-Bodys. Normale Routen bearbeiten ein einzelnes Objekt und
# kommen mit wenig aus; nur der Graph-Import braucht viel. Größere Bodies → 413.
# MAX_BODY=2mb
# MAX_IMPORT_BODY=20mb
