# Production configuration (behind a reverse proxy / HTTPS)
# Copy this file to `.env` and adjust. `.env` is neither committed nor deployed
# (see .gitignore and the rsync excludes in GitHub Actions).
# docker compose reads `.env` automatically for the ${VAR} placeholders.
#
# Image tags (independent; defaults live in docker-compose.yml).
# BACKEND_VERSION=1.0.0
# FRONTEND_VERSION=1.0.0

# Send session cookies over HTTPS only.
# Already ON by default in production (NODE_ENV=production in the image).
# Set to "false" only when testing the prod images over http://localhost.
COOKIE_SECURE=true

# Session lifetime in days (sliding renewal extends it on use).
SESSION_TTL_DAYS=30

# Allow ("true") or completely block ("false") self-registration.
ALLOW_REGISTRATION=true

# Optional: allowed cross-origin(s) with credentials, comma-separated.
# Leave empty when frontend and API share a domain (the default).
# CORS_ORIGIN=https://labviz.example.com

# ── Instance limits ───────────────────────────────────────────────────────────
# Lab Visualizer is entirely free — these values are NOT a paywall but abuse
# protection for instances that strangers can reach.
#
# Default: empty = unlimited. When self-hosting on your own network, leave them.
# On a public instance, set caps so a single account cannot fill your volume.
# Exceeding one returns HTTP 403 with code "limit_reached"; the UI then shows a
# note pointing at self-hosting.
#
# Note: every new account gets an example project (1 project, 3 levels,
# 18 nodes). The backend refuses to start with smaller values, because nobody
# could register any more.
# MAX_PROJECTS_PER_USER=5
# MAX_VIEWS_PER_PROJECT=20
# MAX_NODES_PER_PROJECT=500
# MAX_ASSETS_PER_USER=100

# Largest allowed image file (custom node icons, images in notes) in bytes.
# Unlike the limits above this is NOT a plan boundary but a technical guard: the
# upload is held in memory while being processed, and MAX_BODY must still carry
# the one-third base64 overhead. Default: 1048576 (1 MB).
# MAX_ASSET_BYTES=1048576

# Write requests per minute and IP (GET/HEAD stay unthrottled).
# Default 600 — high enough for API scripting, but it slows down runaway loops
# and mass inserts. 0 turns throttling off entirely.
# RATE_LIMIT_WRITES_PER_MIN=600

# Request body size. Normal routes handle a single object and need little; only
# the graph import needs a lot. Larger bodies get a 413.
# MAX_BODY=2mb
# MAX_IMPORT_BODY=20mb
